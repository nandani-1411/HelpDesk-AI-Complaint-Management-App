<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface_card"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header & Info -->
    <TextView
        android:id="@+id/tv_dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Manage Grievance"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_dialog_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Category &amp; Student Information"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="12dp"
        android:background="@color/divider" />

    <!-- Status Selector Label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Update Resolution Status"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Status Radio Group with official colors -->
    <RadioGroup
        android:id="@+id/rg_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rb_pending"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="@color/status_pending"
            android:text="Pending"
            android:textColor="@color/status_pending"
            android:textSize="13sp"
            android:textStyle="bold" />

        <RadioButton
            android:id="@+id/rb_in_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:buttonTint="@color/primary"
            android:text="In Progress"
            android:textColor="@color/primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <RadioButton
            android:id="@+id/rb_resolved"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:buttonTint="@color/status_resolved"
            android:text="Resolved"
            android:textColor="@color/status_resolved"
            android:textSize="13sp"
            android:textStyle="bold" />
    </RadioGroup>

    <!-- Remarks Header with AI Trigger -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Administrative Reply"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- AI Draft Reply Trigger -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_ai_draft_reply"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:backgroundTint="@color/primary_light"
            android:text="✨ Groq AI Draft"
            android:textColor="@color/primary"
            android:textSize="11sp"
            android:textStyle="bold"
            app:cornerRadius="8dp" />
    </LinearLayout>

    <EditText
        android:id="@+id/et_officer_reply"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input_field"
        android:gravity="top|start"
        android:hint="Type official resolution or tap '✨ Groq AI Draft'..."
        android:inputType="textMultiLine|textCapSentences"
        android:padding="12dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted"
        android:textSize="13sp" />

    <ProgressBar
        android:id="@+id/pb_admin_ai_loading"
        style="?android:attr/progressBarStyleSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="6dp"
        android:indeterminateTint="@color/primary"
        android:visibility="gone" />

</LinearLayout>
