<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/complaint_form_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar_form"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/primary"
            app:navigationIcon="@drawable/ic_back"
            app:title="@string/title_file_complaint"
            app:titleTextColor="@color/white" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Title Label & Input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="Grievance Title *"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/et_complaint_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_field"
                android:hint="@string/hint_title"
                android:inputType="textCapSentences"
                android:importantForAutofill="no"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textSize="15sp" />

            <!-- Description Label & Input -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-bold"
                    android:text="Detailed Description *"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <!-- AI Enhance Trigger Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_groq_enhance"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="8dp"
                    android:text="✨ Groq AI Polish"
                    android:textColor="#0D9488"
                    android:textSize="12sp"
                    app:icon="@drawable/ic_sparkle"
                    app:iconSize="16dp"
                    app:iconTint="#0D9488" />
            </LinearLayout>

            <EditText
                android:id="@+id/et_complaint_description"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_field"
                android:gravity="top|start"
                android:hint="@string/hint_description"
                android:inputType="textMultiLine|textCapSentences"
                android:importantForAutofill="no"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textSize="14sp" />

            <!-- Loading indicator for Groq API call -->
            <LinearLayout
                android:id="@+id/layout_groq_loading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone">

                <ProgressBar
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:indeterminateTint="#0D9488" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Groq LLM is categorizing &amp; structuring..."
                    android:textColor="#0D9488"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- AI Suggestion / Result Chip -->
            <LinearLayout
                android:id="@+id/layout_ai_suggestion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_ai_suggestion"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_sparkle" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_ai_badge_header"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:text="⚡ Groq AI Categorization"
                        android:textColor="#0F766E"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tv_ai_prediction_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Detected: Hostel &amp; Mess (Urgency: High)"
                        android:textColor="#115E59"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btn_apply_ai_suggestion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#0D9488"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:text="Apply"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Category Dropdown Selector -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-bold"
                android:text="Select Category *"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_category"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:boxBackgroundColor="@color/input_bg"
                app:boxCornerRadiusBottomEnd="10dp"
                app:boxCornerRadiusBottomStart="10dp"
                app:boxCornerRadiusTopEnd="10dp"
                app:boxCornerRadiusTopStart="10dp"
                app:boxStrokeColor="@color/input_stroke"
                app:boxStrokeWidth="1.5dp"
                app:endIconTint="@color/text_secondary"
                app:hintEnabled="false">

                <AutoCompleteTextView
                    android:id="@+id/auto_category"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:editable="false"
                    android:hint="Select Issue Category"
                    android:inputType="none"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Photo Proof Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="sans-serif-bold"
                android:text="@string/label_attach_photo"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_capture_photo"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/btn_take_photo"
                android:textAllCaps="false"
                android:textColor="#1A56DB"
                app:cornerRadius="10dp"
                app:icon="@drawable/ic_camera"
                app:iconTint="#1A56DB"
                app:strokeColor="#1A56DB" />

            <!-- Photo Preview Card -->
            <FrameLayout
                android:id="@+id/layout_photo_preview"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="8dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/iv_captured_preview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/surface_tint"
                    android:scaleType="centerCrop" />

                <TextView
                    android:id="@+id/btn_remove_photo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_margin="8dp"
                    android:background="#DC2626"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="Remove"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />
            </FrameLayout>

            <!-- GPS Location Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="sans-serif-bold"
                android:text="@string/label_gps_location"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_fetch_location"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/btn_fetch_gps"
                android:textAllCaps="false"
                android:textColor="#0D9488"
                app:cornerRadius="10dp"
                app:icon="@drawable/ic_location"
                app:iconTint="#0D9488"
                app:strokeColor="#0D9488" />

            <!-- Location Status & Address Readout -->
            <LinearLayout
                android:id="@+id/layout_location_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@color/surface_tint"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_location_address"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Location: Detecting..."
                    android:textColor="#0F766E"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tv_location_coordinates"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Lat: 0.0, Long: 0.0"
                    android:textColor="#64748B"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Submit Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_submit"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="40dp"
                android:backgroundTint="@color/primary"
                android:text="@string/btn_submit_complaint"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="16sp"
                app:cornerRadius="12dp"
                app:elevation="4dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
